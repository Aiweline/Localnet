{
  "name": "localnet",
  "private": true,
  "version": "0.2.1",
  "description": "Weline Localnet is a private peer-to-peer LAN messenger and file transfer app for Windows and macOS.",
  "author": "成都阿玛云科技有限公司 <contact@amayum.com>",
  "homepage": "https://github.com/Aiweline/Localnet",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aiweline/Localnet.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "check": "pnpm typecheck && pnpm build",
    "test:presence": "node --test --experimental-strip-types tests/presence.test.ts",
    "test:transfer-status": "node --test --experimental-strip-types tests/transfer-status.test.ts",
    "release:check": "node scripts/release-version.mjs --check",
    "release:version": "node scripts/release-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@10.28.2"
}
