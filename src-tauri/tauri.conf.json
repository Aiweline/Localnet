{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weline Localnet",
  "version": "0.2.5",
  "identifier": "com.aiweline.localnet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Weline Localnet",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://api.github.com; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "resources": {
      "macos-locales/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese",
          "Spanish",
          "French",
          "German",
          "PortugueseBR",
          "Russian",
          "Japanese",
          "Korean",
          "Arabic"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
